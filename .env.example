# NanoAgent - Configuración
# Copia este archivo como .env y configura tu API key

# Proveedor: groq, together, openrouter, ollama
AI_PROVIDER=groq

# API Key (no necesaria para Ollama)
# Obtén gratis en: https://console.groq.com
GROQ_API_KEY=

# Modelo personalizado (opcional)
# AI_MODEL=llama-3.1-8b-instant

# Para usar Ollama local:
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2:1b
